from tkinter import *

root = Tk()

root.title("Basic Calculator")
root.geometry("425x580")
root.configure(bg="#000000")

def calculate():
    try:
        result = eval(entry.get())
    except ZeroDivisionError:
        print("Cannot divide by zero!")
    except SyntaxError:
        print("Invalid expression!")
    except:
        print("Error!")
    else:
        entry_res.insert(END, str(result))

def press(num):
    entry.insert(END, str(num))

def clear():
    entry.delete(0, END)
    entry_res.delete(0, END)

entry = Entry(root, width=14, font=("Arial", 40), bd=5, relief="flat", bg="#000000", fg="white", justify="right")
entry.grid(row=0, column=0, columnspan=4, pady=10, padx=3, sticky="nsew")
entry_res = Entry(root, width=14, font=("Arial", 25), bd=5, relief="flat", bg="#000000", fg="white", justify="right")
entry_res.grid(row=1, column=0, columnspan=4, pady=3, padx=10, sticky="nsew")

