Button(root, text=".", command=lambda:press("."), width=8, height=5, font=("Arial", 10)).grid(row=5, column=2)
Button(root, text="=", command=calculate, width=8, height=5, font=("Arial", 10)).grid(row=5, column=3)

root = mainloop()