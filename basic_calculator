Button(root, text="C", command=clear, width=3, height=3, font=("Arial", 15), relief="flat", bg="#1D1D1D", fg="#F3511F").grid(row=2, column=0, pady=0, padx=0, sticky="nsew")
Button(root, text="%", command=lambda:press("%"), width=3, height=3, font=("Arial", 15), relief="flat", bg="#1D1D1D", fg="#2EBB41").grid(row=2, column=1, pady=0, padx=0, sticky="nsew")
