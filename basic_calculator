Button(root, text="5", command=lambda:press(5), width=8, height=5, font=("Arial", 10)).grid(row=3, column=1)
Button(root, text="6", command=lambda:press(6), width=8, height=5, font=("Arial", 10)).grid(row=3, column=2)
