from tkinter import *
from simpleeval import simple_eval

root = Tk()

root.title("Basic Calculator")
root.geometry("425x580")
root.configure(bg="#000000")

def calculate():
    try:
        expression = entry.get()
        expression = expression.replace("÷", "/")
        expression = expression.replace("x", "*")
        expression = expression.replace("%", "/100*")

        if expression.endswith("*"):
            expression = expression[:-1]

        result = simple_eval(expression)

        history_item = f"{expression} = {result}"
        history_list.insert(0, history_item)

        entry_res.delete(0, END)
        entry_res.insert(END, str(result))
    except ZeroDivisionError:
        print("You cannot divide by zero!")
        entry_res.delete(0, END)
        entry_res.insert(END, "Error")
    except SyntaxError:
        print("Invalid expression!")
        entry.delete(0, END)
        entry.insert(END, "Error")
        entry_res.delete(0, END)
    except:
        print("Error!")

def press(num):
    entry.insert(END, num)

def clear():
    entry.delete(0, END)
    entry_res.delete(0, END)

def Del():
    expression = entry.get()
    entry.delete(len(expression) - 1, END)
    entry_res.delete(0, END)

def toggle_history():
    if history_list.winfo_viewable():
        history_list.grid_remove()
        root.geometry("425x580") # Original size

    else:
        history_list.grid(row=0, column=0, rowspan=7, padx=10)
        root.geometry("625x580") # Wider to show history

# USER INPUT
entry = Entry(root, width=14, font=("Arial", 40), bd=5, relief="flat", bg="#000000", fg="white", justify="right")
entry.grid(row=0, column=1, columnspan=4, pady=10, padx=3, sticky="nsew")
entry_res = Entry(root, width=14, font=("Arial", 25), bd=5, relief="flat", bg="#000000", fg="white", justify="right")
