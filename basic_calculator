from tkinter import *

root = Tk()

root.title("Basic Calculator")
root.geometry("450x600")

def calculate():
    try:
        result = eval(entry.get())
    except ZeroDivisionError:
        print("Cannot divide by zero!")
    except SyntaxError:
        print("Invalid expression!")
    except:
        print("Error!")
    else:
        entry.delete(0, END)
        entry.insert(END, str(result))

def press(num):
    entry.insert(END, str(num))

def clear():
    entry.delete(0, END)

entry = Entry(root, width=14, font=("Arial", 40), bd=5)
entry.grid(row=0, column=0, columnspan=4, pady=20, padx=20)

#ROW 2
Button(root, text="C", command=clear, width=8, height=5, font=("Arial", 10)).grid(row=1, column=0)
Button(root, text="%", command=lambda:press("%"), width=8, height=5, font=("Arial", 10)).grid(row=1, column=1)
Button(root, text="DEL", command=lambda:press(), width=8, height=5, font=("Arial", 10)).grid(row=1, column=2)
Button(root, text="÷", command=lambda:press("÷"), width=8, height=5, font=("Arial", 10)).grid(row=1, column=3)

