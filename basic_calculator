Button(root, text="8", command=lambda:press(8), width=8, height=5, font=("Arial", 10)).grid(row=2, column=1)
Button(root, text="9", command=lambda:press(9), width=8, height=5, font=("Arial", 10)).grid(row=2, column=2)
